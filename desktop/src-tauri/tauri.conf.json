{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PBJ Accounting",
  "version": "0.1.0",
  "identifier": "com.pbjsa.desktop",
  "build": {
    "frontendDist": "../shell-page"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pbjsa"]
      }
    }
  }
}
