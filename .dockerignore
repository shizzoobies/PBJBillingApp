.github
.claude
.omc
.vscode
node_modules
dist
tmp
desktop
docs/plans
docs/prod-snapshots
docs/client-emails
docs/runbooks
*.test.mjs
*.test.ts
*.test.tsx
src/__tests__
coverage
.env
.env.*
*.log
Dockerfile
.dockerignore
